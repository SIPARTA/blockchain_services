# ===========================================================================
# SIPARTA Blockchain Services — Environment Variables
# ===========================================================================
# Copy file ini ke .env dan isi sesuai credential Anda.
# JANGAN commit file .env ke version control.

# --- Relayer Wallet (Admin Backend) ---
# Private key tanpa prefix '0x'. Wallet ini yang membayar gas fee.
RELAYER_PRIVATE_KEY=

# --- Polygon Amoy Testnet RPC ---
POLYGON_AMOY_RPC_URL=https://polygon-amoy.drpc.org

# --- Deployed Contract Addresses — Kontrak Utama (deploy via Hardhat) ---
# Diisi setelah menjalankan: npx hardhat run scripts/deploy_audit.ts --network amoy
SIPARTA_AUDIT_CONTRACT=
SIPARTA_CERTIFICATE_CONTRACT=

# --- Legacy Contract (GasDetectionStorage) — sudah ter-deploy dari siparta_device ---
# Alamat kontrak lama yang menyimpan data sensor mentah langsung on-chain.
# Digunakan oleh siparta_device/blockchain/polygon_client.py dan relay.ts (jika fallback diaktifkan).
# Referensi: blockchain_services/artifacts/deployed_legacy.json
GAS_DETECTION_CONTRACT=0x6FbF430C79b5F9C5c8de3Fb9d0D099C98a47C2D1

# --- Thirdweb (Opsional: jika menggunakan Thirdweb Engine) ---
THIRDWEB_CLIENT_ID=
THIRDWEB_SECRET_KEY=

# --- IPFS / Pinata (untuk upload metadata insiden) ---
PINATA_JWT=your_pinata_jwt_token_here
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/
